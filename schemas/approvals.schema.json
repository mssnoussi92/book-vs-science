{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Approvals",
  "$defs": {
    "Approvals": {
      "type": "object",
      "properties": {
        "sources": {
          "$ref": "#/$defs/Approval"
        },
        "script": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Approval"
          }
        },
        "voice": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Approval"
          }
        },
        "video": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Approval"
          }
        }
      },
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "on": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "words": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "via": {
          "anyOf": [
            {
              "type": "string",
              "const": "conversation"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "on",
        "words",
        "via",
        "hash"
      ],
      "additionalProperties": false
    }
  }
}
