{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LanguagePack",
  "$defs": {
    "LanguagePack": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "name": {
          "type": "string"
        },
        "dir": {
          "type": "string",
          "enum": [
            "rtl",
            "ltr"
          ]
        },
        "wordsPerSecond": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 6
        },
        "limits": {
          "type": "object",
          "properties": {
            "hookFrameWords": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "bookCardWords": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "lineChars": {
              "type": "integer",
              "minimum": 20,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "hookFrameWords",
            "bookCardWords",
            "lineChars"
          ],
          "additionalProperties": false
        },
        "lexicons": {
          "type": "object",
          "properties": {
            "causal": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "generalizing": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sensitive": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "gender",
                  "mental-health",
                  "health",
                  "money",
                  "relationships",
                  "parenting",
                  "body"
                ]
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "forbiddenAdvice": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "applicabilityLine": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "properties": {
            "badge": {
              "type": "object",
              "properties": {
                "confirmed": {
                  "type": "string"
                },
                "nuanced": {
                  "type": "string"
                },
                "contradicted": {
                  "type": "string"
                },
                "unknown": {
                  "type": "string"
                }
              },
              "required": [
                "confirmed",
                "nuanced",
                "contradicted",
                "unknown"
              ],
              "additionalProperties": false
            },
            "certainty": {
              "type": "object",
              "properties": {
                "high": {
                  "type": "string"
                },
                "moderate": {
                  "type": "string"
                },
                "low": {
                  "type": "string"
                },
                "very-low": {
                  "type": "string"
                }
              },
              "required": [
                "high",
                "moderate",
                "low",
                "very-low"
              ],
              "additionalProperties": false
            },
            "bookSays": {
              "type": "string"
            },
            "scienceSays": {
              "type": "string"
            },
            "draft": {
              "type": "string"
            },
            "takes": {
              "default": [
                "1",
                "2"
              ],
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "badge",
            "certainty",
            "bookSays",
            "scienceSays",
            "draft"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "name",
        "dir",
        "wordsPerSecond",
        "limits",
        "lexicons",
        "applicabilityLine",
        "labels"
      ],
      "additionalProperties": false
    }
  }
}
