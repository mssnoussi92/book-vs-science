{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CharacterDef",
  "$defs": {
    "CharacterDef": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "character",
            "narrator"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "biped",
            "mascot"
          ]
        },
        "fictional": {
          "type": "boolean",
          "const": true
        },
        "names": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "voices": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "engine": {
                "type": "string",
                "const": "gemini"
              },
              "model": {
                "type": "string",
                "minLength": 3
              },
              "voice": {
                "type": "string",
                "pattern": "^[A-Z][a-z]+$"
              },
              "castOn": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "engine",
              "model",
              "voice"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "role",
        "kind",
        "fictional",
        "names"
      ],
      "additionalProperties": false
    }
  }
}
