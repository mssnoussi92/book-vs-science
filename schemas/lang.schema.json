{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LangFile",
  "$defs": {
    "LangFile": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "texts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "of": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          }
        }
      },
      "required": [
        "lang",
        "texts"
      ],
      "additionalProperties": false
    }
  }
}
