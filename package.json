{
  "name": "book-vs-science",
  "private": true,
  "license": "MIT",
  "description": "A self-help book's idea, played out by characters, then checked against peer-reviewed research (Egyptian Arabic shorts and long videos).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "bvs": "packages/pipeline/cli.ts"
  },
  "scripts": {
    "bvs": "node packages/pipeline/cli.ts",
    "schemas": "node packages/schema/emit.ts",
    "test": "node --test \"packages/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio",
    "still": "remotion still",
    "render": "remotion render"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/layout-utils": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
