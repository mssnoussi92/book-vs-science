  "book": {
    "book": "subtle-art",
    "basis": "feedback-loop",
    "claims": [
      {
        "id": "c1",
        "statement": "People who judge themselves for feeling bad, instead of accepting the feeling, have more negative emotion and worse psychological health over time.",
        "population": "adults",
        "exposure": "judging one's own negative emotions",
        "comparison": "accepting them",
        "outcome": "negative emotion, psychological health",
        "causal": false,
        "inScope": true
      },
      {
        "id": "c2",
        "statement": "Pushing a negative feeling down does not lower it, and chasing away the thoughts about it makes them come back afterwards.",
        "population": "adults",
        "exposure": "suppressing a feeling, or chasing away its thoughts",
        "comparison": "not suppressing",
        "outcome": "the thought or feeling afterwards",
        "causal": true,
        "inScope": true
      },
      {
        "id": "c3",
        "statement": "Accepting a negative feeling, instead of fighting it, helps.",
        "population": "adults",
        "exposure": "accepting the feeling",
        "comparison": "fighting it, or no strategy",
        "outcome": "negative emotion, distress, psychological health",
        "causal": true,
        "inScope": true
      },
      {
        "id": "c4",
        "statement": "Wanting to be happy is itself what makes people unhappy.",
        "population": "adults",
        "exposure": "valuing or pursuing happiness",
        "comparison": "not pursuing it",
        "outcome": "well-being",
        "causal": true,
        "inScope": false
      }
    ],
